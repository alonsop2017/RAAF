# RAAF cron schedule (supercronic format — standard crontab syntax)
# Logs go to stdout/stderr and are captured by Docker

# PCR sync: every 5 minutes — pull new applicants, download resumes, auto-assess
*/5 * * * * PYTHONPATH=/app RAAF_DB_MODE=db PYTHONIOENCODING=utf-8 python /app/scripts/pcr/watch_applicants.py --once --auto-download --auto-assess >> /app/logs/pcr_sync.log 2>&1

# Email resume ingestion every 6 hours (00:00, 06:00, 12:00, 18:00 UTC)
0 */6 * * * PYTHONPATH=/app RAAF_DB_MODE=db PYTHONIOENCODING=utf-8 python /app/scripts/email_ingestion/ingest_resumes.py >> /app/logs/email_ingestion.log 2>&1

# Daily local backup at 12:30 AM UTC
30 0 * * * PYTHONPATH=/app /app/backup.sh --target local --local-path /app/backups >> /app/logs/backup.log 2>&1

# Daily OneDrive backup at 1:00 AM UTC
0 1 * * * PYTHONPATH=/app /app/backup.sh --target onedrive --remote "onedrive:PeopleFind/RAAF-backups" --quiet >> /app/logs/backup.log 2>&1

# Disk-space and config-integrity health check, hourly
0 * * * * PYTHONPATH=/app python /app/scripts/utils/check_disk_health.py >> /app/logs/health_check.log 2>&1

# Rotate unbounded cron logs + trim activity events feed, daily at 2:00 AM UTC
0 2 * * * PYTHONPATH=/app python /app/scripts/utils/rotate_logs.py >> /app/logs/rotate_logs.log 2>&1

# Purge unmatched email submissions older than 180 days, weekly (Sunday 2:30 AM UTC)
30 2 * * 0 PYTHONPATH=/app python /app/scripts/utils/cleanup_unmatched_submissions.py >> /app/logs/cleanup_unmatched.log 2>&1

# Weekly disk usage report email, Monday 8:00 AM UTC
0 8 * * 1 PYTHONPATH=/app python /app/scripts/utils/weekly_disk_report.py >> /app/logs/weekly_disk_report.log 2>&1
